{
  "info": {
    "_postman_id": "schwab-gateway-v1",
    "name": "schwab-gateway",
    "description": "Local HTTP microservice that centralises Schwab OAuth tokens and proxies market-data calls.\n\nSet the `base_url` collection variable before use (default: `http://localhost:8182`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8182",
      "type": "string"
    },
    {
      "key": "symbol",
      "value": "SPY",
      "type": "string"
    },
    {
      "key": "from_date",
      "value": "2026-03-17",
      "type": "string"
    },
    {
      "key": "to_date",
      "value": "2026-03-21",
      "type": "string"
    },
    {
      "key": "callback_url",
      "value": "",
      "description": "Paste the full callback URL from your browser after completing Schwab login.",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Returns service status and token expiry metadata.\n\n**Response fields**\n- `status` — `\"ok\"` (client ready) or `\"degraded\"` (reauth needed)\n- `client_ready` — boolean\n- `token.age_hours` — hours since token was created\n- `token.refresh_expires_in_hours` — hours until 7-day refresh token expires\n- `token.access_expires_at` — ISO datetime when the current access token expires"
          },
          "response": [
            {
              "name": "200 OK — client ready",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/health",
                  "host": ["{{base_url}}"],
                  "path": ["health"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\",\n  \"client_ready\": true,\n  \"token\": {\n    \"age_hours\": 1.23,\n    \"refresh_expires_in_hours\": 166.77,\n    \"access_expires_at\": \"2026-03-21T10:30:00\"\n  }\n}"
            },
            {
              "name": "200 Degraded — reauth needed",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/health",
                  "host": ["{{base_url}}"],
                  "path": ["health"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"degraded\",\n  \"client_ready\": false,\n  \"token\": {\n    \"error\": \"token file not found\"\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Market Data",
      "item": [
        {
          "name": "Intraday bars (default 5-min, RTH)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/bars/{{symbol}}?from_date={{from_date}}&to_date={{to_date}}&frequency=5&clean=true&resample_60=false",
              "host": ["{{base_url}}"],
              "path": ["bars", "{{symbol}}"],
              "query": [
                { "key": "from_date",    "value": "{{from_date}}" },
                { "key": "to_date",      "value": "{{to_date}}" },
                { "key": "frequency",    "value": "5",           "description": "Bar size in minutes: 1 | 5 | 10 | 15 | 30 | 60" },
                { "key": "clean",        "value": "true",        "description": "Filter to RTH (09:30–16:00 ET) and parse timestamps" },
                { "key": "resample_60",  "value": "false",       "description": "Resample to hourly bars (implies clean=true)" }
              ]
            },
            "description": "Fetch intraday OHLCV bars. Schwab intraday history covers ~10 calendar days.\n\n**clean=false** → columns: `ts_ms, open, high, low, close, volume`  \n**clean=true** → columns: `timestamp (ISO), open, high, low, close, volume` — RTH only  \n**resample_60=true** → same as clean=true, resampled to 60-min bars\n\n`frequency=60` is accepted; the service fetches 30-min bars internally and resamples."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/bars/SPY?from_date=2026-03-17&to_date=2026-03-21&frequency=5&clean=true",
                  "host": ["{{base_url}}"],
                  "path": ["bars", "SPY"],
                  "query": [
                    { "key": "from_date", "value": "2026-03-17" },
                    { "key": "to_date",   "value": "2026-03-21" },
                    { "key": "frequency", "value": "5" },
                    { "key": "clean",     "value": "true" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"symbol\": \"SPY\",\n  \"count\": 312,\n  \"data\": [\n    {\n      \"timestamp\": \"2026-03-17T09:30:00-04:00\",\n      \"open\": 558.12,\n      \"high\": 559.40,\n      \"low\": 557.80,\n      \"close\": 558.95,\n      \"volume\": 1823400\n    }\n  ]\n}"
            },
            {
              "name": "404 No data",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/bars/SPY?from_date=2020-01-01&to_date=2020-01-02",
                  "host": ["{{base_url}}"],
                  "path": ["bars", "SPY"],
                  "query": [
                    { "key": "from_date", "value": "2020-01-01" },
                    { "key": "to_date",   "value": "2020-01-02" }
                  ]
                }
              },
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"detail\": \"No intraday data for SPY (2020-01-01 → 2020-01-02). Schwab intraday history covers ~10 calendar days.\"\n}"
            },
            {
              "name": "503 Client not ready",
              "status": "Service Unavailable",
              "code": 503,
              "body": "{\n  \"detail\": \"Schwab client not initialised — complete the /reauth flow.\"\n}"
            }
          ]
        },
        {
          "name": "Intraday bars (raw, no RTH filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/bars/{{symbol}}?from_date={{from_date}}&to_date={{to_date}}&frequency=5&clean=false",
              "host": ["{{base_url}}"],
              "path": ["bars", "{{symbol}}"],
              "query": [
                { "key": "from_date", "value": "{{from_date}}" },
                { "key": "to_date",   "value": "{{to_date}}" },
                { "key": "frequency", "value": "5" },
                { "key": "clean",     "value": "false" }
              ]
            },
            "description": "Raw bars with epoch-ms timestamps and no RTH filter. Useful when you want pre/post-market data."
          },
          "response": []
        },
        {
          "name": "Intraday bars (hourly, resampled)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/bars/{{symbol}}?from_date={{from_date}}&to_date={{to_date}}&resample_60=true",
              "host": ["{{base_url}}"],
              "path": ["bars", "{{symbol}}"],
              "query": [
                { "key": "from_date",   "value": "{{from_date}}" },
                { "key": "to_date",     "value": "{{to_date}}" },
                { "key": "resample_60", "value": "true" }
              ]
            },
            "description": "Fetches 30-min bars internally, filters to RTH, then resamples to 60-min OHLCV. Returns `timestamp, open, high, low, close, volume`."
          },
          "response": []
        },
        {
          "name": "Daily bars",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/daily/{{symbol}}?from_date=2025-01-01&to_date={{to_date}}",
              "host": ["{{base_url}}"],
              "path": ["daily", "{{symbol}}"],
              "query": [
                { "key": "from_date", "value": "2025-01-01" },
                { "key": "to_date",   "value": "{{to_date}}" }
              ]
            },
            "description": "Daily OHLCV bars. Schwab history extends back to at least 1985 for major equities.\n\nColumns: `date (YYYY-MM-DD), open, high, low, close, volume`"
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/daily/SPY?from_date=2025-01-01&to_date=2026-03-21",
                  "host": ["{{base_url}}"],
                  "path": ["daily", "SPY"],
                  "query": [
                    { "key": "from_date", "value": "2025-01-01" },
                    { "key": "to_date",   "value": "2026-03-21" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"symbol\": \"SPY\",\n  \"count\": 305,\n  \"data\": [\n    {\n      \"date\": \"2025-01-02\",\n      \"open\": 585.12,\n      \"high\": 587.40,\n      \"low\": 583.80,\n      \"close\": 586.15,\n      \"volume\": 62450000\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Weekly bars",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/weekly/{{symbol}}?from_date=2024-01-01&to_date={{to_date}}",
              "host": ["{{base_url}}"],
              "path": ["weekly", "{{symbol}}"],
              "query": [
                { "key": "from_date", "value": "2024-01-01" },
                { "key": "to_date",   "value": "{{to_date}}" }
              ]
            },
            "description": "Weekly OHLCV bars. Each bar represents one calendar week; `date` is the week-start date.\n\nColumns: `date (YYYY-MM-DD), open, high, low, close, volume`"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1 — Get authorization URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.auth_url) {",
                  "    pm.collectionVariables.set('auth_url', json.auth_url);",
                  "    console.log('Open this URL in your browser:', json.auth_url);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reauth",
              "host": ["{{base_url}}"],
              "path": ["reauth"]
            },
            "description": "Generates a Schwab OAuth2 authorization URL and stores it in the `auth_url` collection variable.\n\n**Next steps:**\n1. Copy `auth_url` from the response (or check the Postman console).\n2. Open it in a browser and complete Schwab login (MFA as normal).\n3. After the redirect, copy the full callback URL from the address bar.\n4. Paste it into the `callback_url` collection variable.\n5. Send **2 — Complete reauth**."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"auth_url\": \"https://api.schwabapi.com/v1/oauth/authorize?response_type=code&client_id=YOUR_APP_KEY&redirect_uri=https%3A%2F%2F127.0.0.1&scope=readonly&state=abc123\"\n}"
            }
          ]
        },
        {
          "name": "2 — Complete reauth",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/reauth/complete",
              "host": ["{{base_url}}"],
              "path": ["reauth", "complete"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"callback_url\": \"{{callback_url}}\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "description": "Exchanges the authorization code from the callback URL for a Schwab token, writes `~/.schwab/token.json`, and reinitialises the client.\n\n**Prerequisites:**\n- Set the `callback_url` collection variable to the full URL your browser landed on after Schwab login (e.g. `https://127.0.0.1?code=ABC&state=xyz`).\n- The state in the callback URL must match the one from step 1."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\",\n  \"message\": \"Token written to /root/.schwab/token.json. Client reinitialised.\"\n}"
            },
            {
              "name": "400 State mismatch",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"detail\": \"State mismatch — expected 'abc123', got 'xyz'.\"\n}"
            },
            {
              "name": "400 No pending reauth",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"detail\": \"No pending reauth — call GET /reauth first.\"\n}"
            },
            {
              "name": "502 Token exchange failed",
              "status": "Bad Gateway",
              "code": 502,
              "body": "{\n  \"detail\": \"Schwab token exchange failed: 401 — Unauthorized\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
